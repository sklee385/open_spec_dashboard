{
  "name": "open-spec-dashboard",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:run --workspaces --if-present",
    "dev:frontend": "npm run dev --workspace frontend -- --host 127.0.0.1 --port 13001",
    "dev:backend": "npm run dev --workspace backend"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "dependencies": {
    "multer": "2.5.0"
  }
}
